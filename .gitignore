logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-error.log*

# ===================== 前端通用（musicAdmin + musicClient）=====================
# 依赖包
node_modules/
# 打包产物
dist/
dist-ssr/
# 本地环境配置
*.local
# 构建/缓存文件
.eslintcache
report.html
vite.config.*.timestamp*
tsconfig.tsbuildinfo
yarn.lock
# 前端自动引入配置
/src/auto-import
# 测试覆盖率
tests/**/coverage/

