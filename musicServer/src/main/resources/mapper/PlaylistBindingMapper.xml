<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.music.mapper.PlaylistBindingMapper">

	<insert id="batchInsertBindings">
		INSERT INTO tb_playlist_binding (playlist_id, song_id)
		VALUES
		<foreach collection="songIds" item="songId" separator=",">
			(#{playlistId}, #{songId})
		</foreach>
	</insert>

</mapper>
